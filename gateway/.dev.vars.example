# Copy to gateway/.dev.vars for local development. Never commit the real file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=high

# Optional local settings
AI_ENABLED=true
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
GATEWAY_UPSTREAM_TIMEOUT_MS=15000
GATEWAY_MAX_OUTPUT_TOKENS=4096
GATEWAY_MAX_BODY_BYTES=8192
